{
  "name": "flyergen",
  "version": "1.0.0",
  "description": "Flyer-Generator für Polizeiakademie Niedersachsen",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "render": "node src/cli.js",
    "test": "jest --verbose",
    "test:coverage": "jest --verbose --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/namebadge/**/*.js",
      "!src/namebadge/templates/**"
    ]
  },
  "dependencies": {
    "express": "^4.18.0",
    "handlebars": "^4.7.0",
    "multer": "^2.2.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "supertest": "^7.2.2"
  }
}
